{
  "name": "tentfit",
  "private": true,
  "version": "0.0.0",
  "description": "tentFit — 텐트 배치 시뮬레이터",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "ci:all": "pnpm typecheck && pnpm lint && pnpm gen:schemas && git diff --exit-code presets/ && pnpm validate-presets && pnpm test && pnpm build",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "validate-presets": "tsx scripts/validate-presets.ts",
    "e2e": "playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-18",
    "immer": "11.1.21",
    "konva": "10.7.1",
    "polylabel": "2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/polylabel": "2.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
