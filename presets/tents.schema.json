                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "trapezoid"
                            },
                            "front": {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 5000
                            },
                            "back": {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 5000
                            },
                            "depth": {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 5000
                            },
                            "offset": {
                              "type": "number",
                              "minimum": -5000,
                              "maximum": 5000
