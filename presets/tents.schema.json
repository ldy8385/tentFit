                        "type": "number",
                        "minimum": -5000,
                        "maximum": 5000
                      }
                    },
                    "required": [
                      "kind",
                      "front",
                      "back",
                      "depth",
                      "offset"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "ngon"
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 12
                      },
                      "sizeBy": {
                        "type": "string",
                        "enum": [
                          "diameter",
                          "side"
                        ]
                      },
                      "size": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5000
                      }
                    },
                    "required": [
                      "kind",
                      "n",
                      "sizeBy",
                      "size"
                    ]
