                              "minimum": 1,
                              "maximum": 5000
                            }
                          },
                          "required": [
                            "kind",
                            "w",
                            "h"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "circle"
                            },
                            "d": {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 5000
                            }
                          },
                          "required": [
                            "kind",
                            "d"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "polygon"
                            },
                            "points": {
                              "type": "array",
                              "items": {
                                "type": "array",
                                "prefixItems": [
                                  {
                                    "type": "number",
                                    "minimum": -10000,
                                    "maximum": 10000
                                  },
                                  {
                                    "type": "number",
                                    "minimum": -10000,
                                    "maximum": 10000
                                  }
                                ],
                                "items": false,
                                "minItems": 2,
                                "maxItems": 2
