{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tentFit 텐트 프리셋 파일",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "tent": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "outer": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "rect"
                      },
                      "w": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5000
                      },
                      "h": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5000
                      }
                    },
                    "required": [
                      "kind",
                      "w",
                      "h"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "circle"
                      },
                      "d": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5000
                      }
                    },
                    "required": [
                      "kind",
                      "d"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "polygon"
                      },
                      "points": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            },
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "points"
                    ]
                  }
                ]
              },
              "outerTemplate": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "rect"
                      },
                      "w": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5000
                      },
                      "h": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5000
                      },
                      "square": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "kind",
                      "w",
                      "h"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "trapezoid"
                      },
                      "front": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5000
                      },
                      "back": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5000
                      },
                      "depth": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5000
                      },
