                    "y": {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    },
                    "rotation": {
                      "type": "number"
                    },
                    "template": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "rect"
                            },
                            "w": {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 5000
                            },
                            "h": {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 5000
                            },
                            "square": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "kind",
                            "w",
                            "h"
