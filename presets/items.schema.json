{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tentFit 물건 프리셋 파일",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "MAT",
              "CHAIR",
              "TABLE",
              "FURNITURE",
              "RUG",
              "ETC"
            ]
          },
          "shape": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "rect"
                  },
                  "w": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5000
                  },
                  "h": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5000
                  }
                },
                "required": [
                  "kind",
                  "w",
                  "h"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "circle"
                  },
                  "d": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5000
                  }
                },
                "required": [
                  "kind",
                  "d"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "polygon"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": -10000,
                          "maximum": 10000
                        },
                        {
                          "type": "number",
                          "minimum": -10000,
                          "maximum": 10000
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                },
                "required": [
                  "kind",
                  "points"
                ]
              }
            ]
          },
          "color": {
            "type": "string",
            "enum": [
              "blue",
              "teal",
              "green",
              "purple",
              "pink",
              "gray",
              "sky",
              "brown"
            ]
          },
          "countsArea": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "shape",
          "color",
          "countsArea"
        ]
      }
    }
  },
  "required": [
    "items"
  ]
}
